# Variables del backend de La Llave. En Render: Environment → añadir cada una.
# NUNCA pongas claves reales en este archivo ni en el repositorio.

# ── Autocomplete (Google) ───────────────────────────────────────────────
AC_PRESUPUESTO_SEG=420          # segundos máximos de sopa de letras (7 min)
AC_CONCURRENCIA=2               # consultas en paralelo; 2 = prudente (decisión de Nuria)
AC_PAUSA_MIN=0.25               # pausa aleatoria entre consultas, en segundos
AC_PAUSA_MAX=0.8

# ── DataForSEO (de pago: PAA, búsquedas relacionadas y volumen) ─────────
# Sin estas dos variables, PAA y volumen de pago se desactivan y lo dicen en Avisos.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_MAX_PREGUNTAS=15     # semillas cuya SERP se lee para sacar PAA
DATAFORSEO_MAX_VOLUMEN=3000     # tope de keywords a las que se pide volumen

# ── Guardado de las recogidas ───────────────────────────────────────────
RECOGIDAS_DIR=                  # vacío = carpeta «recogidas/» en la raíz del repo
# Opcional: Supabase Storage, para que las recogidas sobrevivan a los reinicios de Render
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=la-llave

# ── Conector MCP (para usar La Llave desde claude.ai) ───────────────────
MCP_RUTA=mcp                    # pon algo largo e imposible de adivinar: es la «contraseña»
PUBLIC_URL=https://la-llave-qicn.onrender.com   # URL pública del backend, para los enlaces de descarga
